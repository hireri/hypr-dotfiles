{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "artix2_small",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Storage",
      "format": "{size-used} / {size-total} ({size-percentage})"
    }
  ]
}